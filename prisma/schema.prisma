generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AirGrade {
  good
  moderate
  bad
  very_bad
}

enum VentilationStatus {
  recommended
  caution
  avoid
}

model MonitoringStation {
  id        String              @id
  name      String
  sido      String
  sigungu   String
  address   String
  latitude  Float
  longitude Float
  readings  AirQualityReading[]

  @@index([sido, sigungu])
}

model AirQualityReading {
  id         String            @id
  stationId  String
  measuredAt DateTime
  pm10       Float
  pm25       Float
  o3         Float
  no2        Float
  co         Float
  so2        Float
  humidity   Float
  windSpeed  Float
  station    MonitoringStation @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, measuredAt])
  @@index([measuredAt])
}

model AirRegionMetric {
  id                   String            @id
  sido                 String
  sigungu              String?
  stationCount         Int
  goodCount            Int
  moderateCount        Int
  badCount             Int
  veryBadCount         Int
  avgPm10              Float
  avgPm25              Float
  avgO3                Float
  avgHumidity          Float
  avgWindSpeed         Float
  airGrade             AirGrade
  ventilationStatus    VentilationStatus
  ventilationScore     Int
  outdoorActivityScore Int
  laundryScore         Int
  freshnessScore       Float
  measuredAt           DateTime

  @@index([sido, sigungu])
}

model StationAirMetric {
  stationId            String            @id
  stationName          String
  sido                 String
  sigungu              String
  pm10                 Float
  pm25                 Float
  o3                   Float
  humidity             Float
  windSpeed            Float
  airGrade             AirGrade
  ventilationStatus    VentilationStatus
  ventilationScore     Int
  outdoorActivityScore Int
  laundryScore         Int
  freshnessScore       Float
  measuredAt           DateTime
}

model RawAirApiResponse {
  id        String   @id @default(cuid())
  payload   Json
  createdAt DateTime @default(now())
}

model PipelineRun {
  id           String    @id @default(cuid())
  status       String
  startedAt    DateTime
  finishedAt   DateTime?
  sampleCount  Int       @default(0)
  errorMessage String?
}
